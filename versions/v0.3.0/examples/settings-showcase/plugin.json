{
  "id": "settings-showcase",
  "name": "设置与存储演示",
  "version": "1.0.0",
  "description": "验证宿主生成的设置页、即时更新、独立持久化数据与动态尺寸。",
  "icon": "⚙",
  "layout": { "span": 5, "height": 280 },
  "defaultEnabled": true,
  "capabilities": ["storage", "open-url"],
  "settings": [
    {
      "id": "style",
      "title": "外观",
      "description": "这些控件均由宿主根据 plugin.json 自动绘制。",
      "fields": [
        { "key": "title", "type": "text", "label": "标题", "default": "我的设置插件", "maxLength": 40 },
        { "key": "accent", "type": "color", "label": "强调色", "default": "#a58bfa" },
        { "key": "large", "type": "toggle", "label": "大字号", "default": false },
        { "key": "padding", "type": "slider", "label": "内边距", "min": 0, "max": 60, "step": 2, "default": 20 },
        { "key": "description", "type": "textarea", "label": "自定义说明", "default": "更改设置后无需重启插件。", "maxLength": 200 }
      ]
    },
    {
      "id": "other",
      "title": "更多控件",
      "fields": [
        { "key": "countStep", "type": "number", "label": "计数步长", "min": 1, "max": 20, "step": 1, "default": 1 },
        { "key": "direction", "type": "select", "label": "排列方向", "options": [{"value":"column","label":"纵向"},{"value":"row","label":"横向"}], "default": "column" },
        { "key": "target", "type": "url", "label": "测试网址", "default": "https://example.com", "description": "网址通过宿主确认后打开。" }
      ]
    }
  ]
}
